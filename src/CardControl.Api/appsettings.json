{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "PartnerAuth": {
    "Authority": "http://localhost:5090",
    "Audience": "api://card-control",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },

  // Private keys for partner-encrypted PANs. Deliberately empty: each environment supplies its own
  // (in AKS: a Key Vault-backed secret mounted into the pod, passed as Keys:N:PrivateKeyPem).
  "PanEncryption": {
    "Keys": []
  },

  // Corporates each partner client (token "azp") may act for. Anything not listed is refused.
  "Entitlements": {
    "Clients": {
      "partner-app": [ "CORP-1001", "CORP-2002" ]
    }
  },

  // The starter kit stubs. In AKS these would be in-cluster service names, with mTLS from the mesh.
  // Resilience: TimeoutSeconds is the whole call including retries; each attempt gets AttemptTimeoutSeconds.
  // Retries apply to tokenise and get-card only; lock/unlock are never retried (see DownstreamServiceCollectionExtensions).
  // Also available: RetryBaseDelayMilliseconds, CircuitBreakerFailureRatio, CircuitBreakerMinimumThroughput,
  // CircuitBreakerBreakSeconds.
  "Downstream": {
    "Tokenisation": { "BaseUrl": "http://localhost:5070", "TimeoutSeconds": 5, "AttemptTimeoutSeconds": 2, "MaxRetryAttempts": 2 },
    "CardPlatform": { "BaseUrl": "http://localhost:5080", "TimeoutSeconds": 5, "AttemptTimeoutSeconds": 2, "MaxRetryAttempts": 2 }
  }
}
